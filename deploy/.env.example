# Copy to .env (gitignored) and fill in.

# Your domain; tools are served at fitness.<domain>, games.<domain>.
DOMAIN=example.com

# Cloudflare API token, permission Zone → DNS → Edit, limited to this zone.
CLOUDFLARE_API_TOKEN=

# Host folder with the data (users/, fitness/). Created if missing.
DATA_DIR=/var/lib/casaos_data/.media/Vault/Apps/HomeTools

# Group that owns the Docker socket: stat -c %g /var/run/docker.sock
DOCKER_GID=

# Where home-tools listens, as seen from the Caddy container.
UPSTREAM=home-tools:8080
